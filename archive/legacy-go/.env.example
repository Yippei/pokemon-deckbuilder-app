# Backend
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL connection string.
# Local example:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/pokemon_deckbuilder?sslmode=disable
# AWS RDS example:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# AI API key.
# Set either GROQ_API_KEY or GEMINI_API_KEY.
# Keep API keys in Render environment variables or a secret manager, not in source control.
GROQ_API_KEY=
GEMINI_API_KEY=
